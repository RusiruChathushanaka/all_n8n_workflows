{"createdAt":"2025-06-30T04:16:09.676Z","updatedAt":"2025-07-02T06:26:38.000Z","id":"us262TWRSH85GthH","name":"PO Data Extractor","active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"c3791413-5111-4389-ab9b-fe052bf80727","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,0],"id":"4ca392c4-cbbe-4a1b-b7dc-c0c50f6db898","name":"Webhook","webhookId":"c3791413-5111-4389-ab9b-fe052bf80727"},{"parameters":{"options":{}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.4,"position":[2300,0],"id":"46aa4489-273b-4dcf-b4fd-40d894cc7f6a","name":"Respond to Webhook"},{"parameters":{"method":"POST","url":"https://api.mistral.ai/v1/ocr","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"mistral-ocr-latest\",\n  \"document\": {\n    \"type\": \"document_url\",\n    \"document_url\": \"{{ $('Edit Fields').item.json.fileUrl }}\"\n  },\n  \"include_image_base64\": true\n}","options":{"response":{"response":{"responseFormat":"json"}}}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[480,0],"id":"2b66ab53-7bd0-4d1f-b930-8e3b1a50a74b","name":"HTTP Request","credentials":{"httpHeaderAuth":{"id":"clfJNQxDZVBTIKZ0","name":"Mistral Header Auth"}}},{"parameters":{"jsCode":"// Get all items from the previous HTTP Request node\nconst items = $input.all();\n\n// Initialize an array to hold all the page content from all input items\nconst allPages = [];\n\n// Loop through each item coming from the previous node\nfor (const item of items) {\n  // Check if the item has a 'pages' property and if it's an array\n  if (item.json && Array.isArray(item.json.pages)) {\n    // Loop through each page object within the 'pages' array\n    for (const page of item.json.pages) {\n      // Create a new, cleaner object for each page\n      const formattedPage = {\n        page: page.index + 1, // Convert 0-based index to 1-based page number\n        content: page.markdown\n      };\n      // Add this new object to our collection\n      allPages.push(formattedPage);\n    }\n  }\n}\n\n// The Code node should return an array of items.\n// We will return a single item containing the final consolidated document.\nreturn [{\n  json: {\n    document: allPages\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[700,0],"id":"5c5b4d9a-0aa4-462d-8fd8-75ccd2829f3f","name":"Code"},{"parameters":{"promptType":"define","text":"=PO Document Content :\n\n{{ $json.document.toJsonString() }}\n\nUser Requested Schema :\n\n{{ $('Edit Fields').item.json.jsonSchema.toJsonString() }}\n\n","options":{"systemMessage":"=You are a data extraction specialist with advanced expertise in processing purchase order (PO) documents and transforming unstructured data into structured JSON outputs. I require your precision and technical proficiency to accurately extract and map data from PO documents according to a provided user schema.  \n\nPlease execute the following steps with meticulous attention to detail:  \n\n- **Document Parsing**: Thoroughly analyze the extracted PO document text to identify all relevant fields, including but not limited to vendor details, item descriptions, quantities, unit prices, and total amounts.  \n\n- **Schema Alignment**: Cross-reference the identified data points with the user-provided JSON schema to ensure all requested fields are accounted for.  \n\n- **Data Extraction**: Extract and map each data point to its corresponding field in the output JSON structure.  \n\n- **Handling Missing Data**: If a requested field is not present in the PO document, explicitly mark it as `null` in the JSON output to maintain clarity and avoid ambiguity.  \n\n- **Validation**: Verify the accuracy of the extracted data against the original document to prevent errors or omissions.  \n\n- **Output Formatting**: Return the final extracted data in a clean, well-structured JSON format that strictly adheres to the user's schema requirements.  \n\nLeverage your expertise in document processing and data transformation to deliver a precise, reliable, and schema-compliant JSON output. Your ability to handle unstructured data and enforce strict formatting standards is critical to the success of this task."}},"type":"@n8n/n8n-nodes-langchain.agent","typeVersion":2,"position":[940,0],"id":"8c956e14-24ad-4e81-8b31-5b2cd8519a5c","name":"AI Agent"},{"parameters":{"model":"google/gemini-2.5-flash-preview-05-20:thinking","options":{}},"type":"@n8n/n8n-nodes-langchain.lmChatOpenRouter","typeVersion":1,"position":[860,240],"id":"cb5defa7-3563-49b0-b545-3dcb2990692f","name":"OpenRouter Chat Model","credentials":{"openRouterApi":{"id":"xas472ZBb2q9n8Hk","name":"OpenRouter account"}}},{"parameters":{"sessionIdType":"customKey","sessionKey":"={{ $execution.id }}"},"type":"@n8n/n8n-nodes-langchain.memoryPostgresChat","typeVersion":1.3,"position":[1060,240],"id":"0058d8bc-5d9c-4f1b-8b1f-50cd1e8f4f31","name":"Postgres Chat Memory","credentials":{"postgres":{"id":"3L0BjpaMuG3KHn2D","name":"Postgres account"}}},{"parameters":{"assignments":{"assignments":[{"id":"2b46314e-b550-4ec0-8a7a-9f044df603f7","name":"fileUrl","value":"={{ $json.body.fileUrl }}","type":"string"},{"id":"e007b013-b5cd-4206-90b2-9a563d81b79a","name":"fileName","value":"={{ $json.body.fileName }}","type":"string"},{"id":"3b63bbae-6b45-491b-a601-5b58c37f9930","name":"filePath","value":"={{ $json.body.filePath }}","type":"string"},{"id":"35793bf8-97b0-4d16-af54-a61245610d3f","name":"timestamp","value":"={{ $json.body.timestamp }}","type":"string"},{"id":"1c943ac9-bee0-4746-8715-101337fa52cb","name":"jsonSchema","value":"={{ $json.body.json.toJsonString() }}","type":"object"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[220,0],"id":"4077887a-acdc-4fab-a7e9-b231cde52b52","name":"Edit Fields"},{"parameters":{"assignments":{"assignments":[{"id":"4d3b89fd-d6db-4e72-9269-29c6ec