else if (typeof data.transcript === 'string') {\n    transcriptText = data.transcript;\n  }\n} else if (data.text) {\n  // Format for single transcript object with text property\n  transcriptText = data.text;\n}\n\n// Clean up the transcript (remove extra spaces, normalize punctuation)\nconst cleanedTranscript = transcriptText\n  .replace(/\\s+/g, ' ')\n  .replace(/\\s([.,!?])/g, '$1')\n  .trim();\n\nreturn {\n  json: {\n    success: true,\n    videoUrl: $input.first().json.body?.videoUrl || 'From transcript',\n    rawTranscript: data.text || data.transcript,\n    cleanedTranscript,\n    duration: data.duration,\n    offset: data.offset,\n    language: data.lang\n  }\n};"},"id":"2463b980-f431-4d90-a779-dbd63dd35491","name":"processTranscript","type":"n8n-nodes-base.function","position":[540,380],"typeVersion":1},{"parameters":{"url":"https://youtube-transcript3.p.rapidapi.com/api/transcript","sendQuery":true,"queryParameters":{"parameters":[{"name":"videoId","value":"={{ $('YoutubeVideoURL').item.json['Youtube Video Url'].match(/^.*(youtu.be\\/|v\\/|u\\/\\w\\/|embed\\/|watch\\?v=|&v=)([^#&?]*).*/)[2] }}"}]},"sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-rapidapi-host","value":"youtube-transcript3.p.rapidapi.com"},{"name":"x-rapidapi-key","value":"29a4e8f77dmsh7dde5ad551d0106p1f0c87jsn334e9f06a2f5"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"bodyParameters":{"parameters":[{"name":"url","value":"={{ $json['Youtube Video Url'] }}"}]},"options":{}},"id":"d5603bc9-2b59-496f-b4ef-dd9d8a62c914","name":"extractTranscript","type":"n8n-nodes-base.httpRequest","position":[300,380],"typeVersion":3},{"parameters":{"tableId":"n8n_Youtube_Video_Summary","fieldsUi":{"fieldValues":[{"fieldId":"video_url","fieldValue":"={{ $('YoutubeVideoURL').item.json['Youtube Video Url'] }}"},{"fieldId":"transcript","fieldValue":"={{ $('cleanedTranscript').item.json.transcript }}"},{"fieldId":"description","fieldValue":"={{ $('AI Agent - Description').it